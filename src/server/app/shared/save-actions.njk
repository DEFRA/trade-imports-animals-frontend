{% from "govuk/components/button/macro.njk" import govukButton %}

{#
  implicitSubmitButton — a hidden implicit-submit button, placed ahead of a
  page's other submit controls so Enter activates it rather than the first
  one that follows.

  Params:
    text   (string) the accessible name of the control Enter activates
    name   (string) optional form field name for the submitted action
    value  (string) the value posted for name, when name is set
#}
{% macro implicitSubmitButton(params) %}
  <button type="submit"{% if params.name %} name="{{ params.name }}" value="{{ params.value }}"{% endif %} class="govuk-visually-hidden" aria-hidden="true" tabindex="-1">{{ params.text }}</button>
{% endmacro %}

{#
  saveActions — the Save and continue controls of a journey page.

  Params:
    hubHref                (string)  where Cancel and return to overview goes
    copy                   (object)  the shared save-actions copy
    primary                (object)  optional govukButton params for the primary button
    secondary              (object)  optional { text, name, value } for a secondary submit beside the primary
    showReturnControls     (boolean) offer the return controls; default true
    uploadPath             (string)  the path every save button posts to, as multipart
#}
{% macro saveActions(params) %}
  {% set copy = params.copy %}
  {% set primary = params.primary %}
  {% set secondary = params.secondary %}
  {% set uploadPath = params.uploadPath %}
  {% set showReturnControls = params.showReturnControls if params.showReturnControls is defined else true %}
  {% set fileAttributes = { formaction: uploadPath, formenctype: "multipart/form-data" } if uploadPath else {} %}
  {% set primaryButton = withAttributes(primary or { text: copy.saveAndContinue }, fileAttributes) %}
  {% set secondaryButton = {
    text: secondary.text,
    classes: "govuk-button--secondary",
    name: secondary.name,
    value: secondary.value
  } if secondary %}
  {% set hubExitButton = withAttributes({
    text: copy.saveAndReturnToHub,
    classes: "govuk-button--secondary",
    name: "exit",
    value: "hub"
  }, fileAttributes) %}
  <div class="govuk-button-group">
    {{ govukButton(primaryButton) }}
    {% if showReturnControls %}
      {{ govukButton(hubExitButton) }}
    {% endif %}
    {% if secondary %}
      {{ govukButton(secondaryButton) }}
    {% endif %}
  </div>
  {% if showReturnControls %}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ params.hubHref }}">{{ copy.cancelAndReturnToHub }}</a>
    </p>
  {% endif %}
{% endmacro %}
