{% extends "shared/layout.njk" %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "shared/save-actions.njk" import saveActions %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  <span class="govuk-caption-xl">{{ copy.caption }}</span>
  <h1 class="govuk-heading-xl">{{ copy.heading }}</h1>

  {{ govukInsetText({ text: copy.insetWarning }) }}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />

    {% if rows.length %}
      <table class="govuk-table">
        <caption class="govuk-table__caption govuk-visually-hidden">{{ copy.table.caption }}</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">{{ copy.table.headings.documentType }}</th>
            <th scope="col" class="govuk-table__header">{{ copy.table.headings.documentReference }}</th>
            <th scope="col" class="govuk-table__header">{{ copy.table.headings.issueDate }}</th>
            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">{{ copy.actions.remove }}</span></th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for row in rows %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">{{ row.documentType }}</td>
              <td class="govuk-table__cell">{{ row.documentReference }}</td>
              <td class="govuk-table__cell">{{ row.issueDate }}</td>
              <td class="govuk-table__cell">
                <button type="submit"
                        class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                        name="action"
                        value="remove:{{ row.index }}"
                        data-module="govuk-button">
                  {{ copy.actions.remove }}
                  <span class="govuk-visually-hidden"> {{ row.documentType }} {{ row.documentReference }}</span>
                </button>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}

    {{ govukSelect({
      id: "documentType",
      name: "documentType",
      label: { text: copy.labels.documentType, classes: "govuk-label--s" },
      items: documentTypeItems,
      errorMessage: errors.documentType and { text: errors.documentType }
    }) }}

    {{ govukInput({
      id: "documentReference",
      name: "documentReference",
      label: { text: copy.labels.documentReference, classes: "govuk-label--s" },
      classes: "govuk-input--width-20",
      value: values.documentReference,
      errorMessage: errors.documentReference and { text: errors.documentReference }
    }) }}

    {{ govukInput(issueDate) }}

    {{ govukButton({
      text: copy.actions.addDocument,
      classes: "govuk-button--secondary",
      name: "action",
      value: "add"
    }) }}

    {{ saveActions(hubHref, { text: sharedCopy.saveActions.saveAndContinue, name: "action", value: "continue" }, sharedCopy.saveActions) }}
  </form>
{% endblock %}
