{% extends "shared/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "shared/save-actions.njk" import saveActions %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  <span class="govuk-caption-xl">{{ copy.caption }}</span>
  <h1 class="govuk-heading-xl">{{ copy.heading }}</h1>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />

    <div class="govuk-form-group{% if errors.countryOfConsignment %} govuk-form-group--error{% endif %}">
      <label class="govuk-label govuk-label--m" for="countryOfConsignment">
        {{ copy.countryOfConsignment.label }}
      </label>
      {% if errors.countryOfConsignment %}
        <p id="countryOfConsignment-error" class="govuk-error-message">
          <span class="govuk-visually-hidden">Error:</span> {{ errors.countryOfConsignment }}
        </p>
      {% endif %}
      <select class="govuk-select govuk-!-width-one-half{% if errors.countryOfConsignment %} govuk-select--error{% endif %}" id="countryOfConsignment" name="countryOfConsignment"{% if errors.countryOfConsignment %} aria-describedby="countryOfConsignment-error"{% endif %}>
        {% for item in countryItems %}
          {% if item.items %}
            <optgroup label="{{ item.label }}">
              {% for option in item.items %}
                <option value="{{ option.value }}"{% if values.countryOfConsignment == option.value %} selected{% endif %}>{{ option.text }}</option>
              {% endfor %}
            </optgroup>
          {% else %}
            <option value="{{ item.value }}"{% if values.countryOfConsignment == item.value %} selected{% endif %}>{{ item.text }}</option>
          {% endif %}
        {% endfor %}
      </select>
    </div>

    {{ govukInput({
      id: "internalReference",
      name: "internalReference",
      label: {
        text: copy.internalReference.label,
        classes: "govuk-label--m"
      },
      hint: { text: copy.internalReference.hint },
      classes: "govuk-!-width-three-quarters",
      value: values.internalReference,
      attributes: { maxlength: 30 },
      errorMessage: errors.internalReference and { text: errors.internalReference }
    }) }}

    {{ saveActions(hubHref, copy = sharedCopy.saveActions) }}
  </form>
{% endblock %}
