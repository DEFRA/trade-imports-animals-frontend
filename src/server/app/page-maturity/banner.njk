{%- from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner -%}
{%- if pageMaturity -%}
  {%- set pageMaturityHtml -%}
    <span class="govuk-visually-hidden">{{ pageMaturity.hiddenPrefix }}</span> {{ pageMaturity.text }}
  {%- endset -%}
  {{ govukPhaseBanner({
    tag: { text: pageMaturity.tag.text, classes: pageMaturity.tag.classes },
    html: pageMaturityHtml
  }) }}
{%- endif -%}
