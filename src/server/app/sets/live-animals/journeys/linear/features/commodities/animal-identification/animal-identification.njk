{% extends "shared/layout.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "live-animals/journeys/linear/features/commodities/animal-identification/_identification-card.njk" import identificationCard %}
{% from "live-animals/journeys/linear/features/commodities/animal-identification/_selected-commodities-summary.njk" import selectedCommoditiesSummary %}
{% from "shared/save-actions.njk" import implicitSubmitButton, saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "shared/error-summary.njk" %}

      {{ sectionCaption(caption) }}
      <h1 class="govuk-heading-l">{{ copy.title }}</h1>

      {{ govukInsetText({
        text: copy.inset
      }) }}
    </div>
  </div>

  {{ selectedCommoditiesSummary(selectedTable, selectedCommoditiesCopy) }}

  <p class="govuk-body">
    <a class="govuk-link" href="{{ addHref }}">{{ copy.addAnotherCommodity }}</a>
  </p>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {{ implicitSubmitButton({ text: copy.saveAndFinish, name: "action", value: "implicit-submit" }) }}

    {% for section in sections %}
      <h2 class="govuk-heading-l">{{ section.heading }}</h2>
      {% for card in section.cards %}
        {{ identificationCard(card, copy) }}
      {% endfor %}
    {% endfor %}

    {{ saveActions({ hubHref: hubHref, copy: sharedCopy.saveActions, amend: amend }) }}
  </form>
{% endblock %}
