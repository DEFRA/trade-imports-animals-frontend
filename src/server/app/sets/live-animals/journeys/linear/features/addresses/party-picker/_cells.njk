{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% macro pickerSelectCell(row, copy) %}
  {% set selectLabel %}
    <span class="govuk-visually-hidden">{{ copy.selectRowPrefix }} {{ row.name }}</span>
  {% endset %}
  {{ govukRadios({
    idPrefix: row.idPrefix,
    name: "party",
    classes: "govuk-radios--small",
    items: [{
      value: row.id,
      html: selectLabel,
      checked: row.checked
    }]
  }) }}
{% endmacro %}

{% macro pickerAddressCell(row) %}
  {%- for line in row.addressLines -%}
    {{ line }}{% if not loop.last %}<br>{% endif %}
  {%- endfor -%}
{% endmacro %}

{% macro pickerViewCell(row, copy) %}
  <a class="govuk-link" href="{{ row.viewHref }}">{{ copy.view }}<span class="govuk-visually-hidden"> {{ row.name }}</span></a>
{% endmacro %}
