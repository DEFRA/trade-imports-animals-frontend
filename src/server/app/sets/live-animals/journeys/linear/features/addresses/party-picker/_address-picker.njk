{% from "submitted-search/macro.njk" import appSubmittedSearch %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "shared/save-actions.njk" import saveActions %}

{% macro pickerError(picker, copy) %}
  <p id="party-error" class="govuk-error-message">
    <span class="govuk-visually-hidden">{{ copy.errorPrefix }}</span> {{ picker.error }}
  </p>
{% endmacro %}

{% macro addressPickerResults(picker, copy) %}
  <h2 class="govuk-heading-m">{{ copy.resultsHeading }}</h2>

  {% if picker.rows.length %}
    <p class="govuk-body">{{ picker.resultsCount }}</p>

    {% set rows = [] %}
    {% for row in picker.rows %}
      {% set selectLabel %}
        <span class="govuk-visually-hidden">{{ copy.selectRowPrefix }} {{ row.name }}</span>
      {% endset %}
      {% set selectCell %}
        {{ govukRadios({
          idPrefix: row.idPrefix,
          name: "party",
          classes: "govuk-radios--small",
          items: [{
            value: row.id,
            html: selectLabel,
            checked: row.checked
          }]
        }) }}
      {% endset %}
      {% set detailsCell %}
        <details class="govuk-details">
          <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">{{ copy.viewDetails }}<span class="govuk-visually-hidden"> {{ copy.viewDetailsFor }} {{ row.name }}</span></span>
          </summary>
          <div class="govuk-details__text">
            <ul class="govuk-list">
              {% for line in row.detailLines %}
                <li>{{ line }}</li>
              {% endfor %}
            </ul>
          </div>
        </details>
      {% endset %}
      {% set ignored = rows.push([
        { html: selectCell },
        { text: row.name },
        { text: row.addressText },
        { text: row.country },
        { html: detailsCell }
      ]) %}
    {% endfor %}

    {% set fieldsetContent %}
      {% if picker.error %}
        {{ pickerError(picker, copy) }}
      {% endif %}
      {{ govukTable({
        head: [
          { html: '<span class="govuk-visually-hidden">' + copy.table.selectHidden + '</span>' },
          { text: copy.table.name },
          { text: copy.table.address },
          { text: copy.table.country },
          { html: '<span class="govuk-visually-hidden">' + copy.table.actionsHidden + '</span>' }
        ],
        rows: rows
      }) }}
    {% endset %}

    <div class="govuk-form-group{{ ' govuk-form-group--error' if picker.error }}">
      {{ govukFieldset({
        legend: { text: copy.resultsHeading, classes: "govuk-visually-hidden" },
        describedBy: "party-error" if picker.error,
        html: fieldsetContent
      }) }}
    </div>

    {% if picker.pagination %}
      {{ govukPagination(picker.pagination) }}
    {% endif %}
  {% else %}
    <p class="govuk-body">{{ copy.noMatches }}</p>
    {% if picker.error %}
      <div class="govuk-form-group govuk-form-group--error">
        {{ pickerError(picker, copy) }}
      </div>
    {% endif %}
  {% endif %}
{% endmacro %}

{% macro addressPicker(picker, crumb, copy, saveActionsCopy, hubHref, amend = none) %}
  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
    <input type="hidden" name="page" value="{{ picker.page }}" />
    {% if picker.selected %}
      <input type="hidden" name="selected" value="{{ picker.selected.id }}" />
    {% endif %}

    {{ appSubmittedSearch({
      id: "q",
      name: "q",
      value: picker.query,
      label: { text: copy.search.label },
      hint: { text: copy.search.hint },
      button: { text: copy.search.button },
      wrapperClasses: "govuk-!-width-one-half"
    }) }}

    {% if picker.selected %}
      {{ govukInsetText({ text: copy.selectedAddressPrefix + " " + picker.selected.name }) }}
    {% endif %}

    {{ addressPickerResults(picker, copy) }}

    {{ saveActions(
      hubHref,
      { text: saveActionsCopy.saveAndContinue, name: "action", value: "save" },
      saveActionsCopy,
      showReturnControls = false,
      amend = amend
    ) }}
  </form>
{% endmacro %}
