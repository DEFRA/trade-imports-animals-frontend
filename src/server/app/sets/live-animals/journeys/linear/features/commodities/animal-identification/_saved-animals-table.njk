{% from "govuk/components/table/macro.njk" import govukTable %}

{% macro savedAnimalsTable(card, copy) %}
  {% set head = card.savedAnimalsTable.head.concat([{ html: '<span class="govuk-visually-hidden">' + copy.table.actionsHidden + '</span>' }]) %}

  {% set rows = [] %}
  {% for unit in card.units %}
    {% set removeCell %}
      <button type="submit" class="govuk-link app-link-button" name="action" value="remove:{{ unit.line }}:{{ unit.unitIndex }}">{{ copy.removeRow }}<span class="govuk-visually-hidden"> {{ unit.removeAria }}</span></button>
    {% endset %}
    {% set ignored = rows.push(card.savedAnimalsTable.rows[loop.index0].concat([{ html: removeCell, classes: "govuk-!-text-align-right" }])) %}
  {% endfor %}

  {{ govukTable({ head: head, rows: rows }) }}
{% endmacro %}
