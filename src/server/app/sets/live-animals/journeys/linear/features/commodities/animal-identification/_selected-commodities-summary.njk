{% from "govuk/components/table/macro.njk" import govukTable %}

{% macro selectedCommoditiesSummary(selectedRows, table, changeHref, headings, copy) %}
  {% set rows = [] %}
  {% for row in selectedRows %}
    {% set changeCell %}
      <a class="govuk-link" href="{{ changeHref }}">{{ copy.change }}<span class="govuk-visually-hidden"> {{ row.name }}</span></a>
    {% endset %}
    {% set ignored = rows.push(table.rows[loop.index0].concat([
      { text: row.animals },
      { html: changeCell, classes: "govuk-!-text-align-right" }
    ])) %}
  {% endfor %}
  {{ govukTable({
    caption: headings.caption,
    captionClasses: "govuk-table__caption--m",
    head: table.head.concat([
      { text: headings.numberOfAnimals },
      { html: '<span class="govuk-visually-hidden">' + headings.actionsHidden + '</span>' }
    ]),
    rows: rows
  }) }}
{% endmacro %}
