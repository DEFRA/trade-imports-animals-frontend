{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block journeyContent %}
  {% set referencePanelHtml %}{{ copy.panel.referencePrefix }}<br><strong>{{ referenceNumber }}</strong>{% endset %}
  {{ govukPanel({
    titleText: copy.panel.title,
    html: referencePanelHtml
  }) }}

  {{ govukSummaryList({
    rows: [
      {
        key: { text: copy.references.notificationLabel },
        value: { text: referenceNumber }
      },
      {
        key: { text: copy.references.customsLabel },
        value: { text: customsDeclarationReference }
      },
      {
        key: { text: copy.references.documentCodeLabel },
        value: { text: customsDocumentCode }
      },
      {
        key: { text: copy.inspection.label },
        value: { text: inspectionStatus }
      }
    ]
  }) }}

  {{ govukWarningText({
    text: copy.warning,
    iconFallbackText: copy.warningFallbackText
  }) }}

  <h2 class="govuk-heading-m">{{ copy.whatYouNeedToDo.heading }}</h2>
  <p class="govuk-body">{{ copy.whatYouNeedToDo.noInspection }}</p>
  {{ govukInsetText({ text: copy.whatYouNeedToDo.canChange }) }}

  <h2 class="govuk-heading-m">{{ copy.whatHappensNext.heading }}</h2>
  <p class="govuk-body">{{ copy.whatHappensNext.inspectorMayUpdate }}</p>
  <p class="govuk-body">{{ copy.whatHappensNext.ifChanges }}</p>

  <h2 class="govuk-heading-m">{{ copy.viewOrAmend.heading }}</h2>
  <p class="govuk-body">{{ copy.viewOrAmend.body }}</p>
  <p class="govuk-body">
    <a class="govuk-link" href="{{ dashboardHref }}">{{ copy.viewOrAmend.dashboardLink }}</a>
  </p>
  {{ govukButton({
    text: copy.createLink,
    href: dashboardHref,
    isStartButton: true
  }) }}
{% endblock %}
