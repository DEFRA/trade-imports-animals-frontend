{# Minimum dashboard from docs/add-a-set.md step 9. #}
{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block journeyContent %}
  <h1 class="govuk-heading-xl">{{ copy.title }}</h1>

  <form method="post" action="{{ startAction }}" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    {{ govukButton({ text: copy.createButton, isStartButton: true }) }}
  </form>

  {% if notificationRows.length %}
    <table class="govuk-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th class="govuk-table__header" scope="col">{{ copy.headings.reference }}</th>
          <th class="govuk-table__header" scope="col">{{ copy.headings.status }}</th>
          <th class="govuk-table__header" scope="col">{{ copy.headings.updated }}</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for row in notificationRows %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">{{ row.reference }}</td>
            <td class="govuk-table__cell">{{ row.status }}</td>
            <td class="govuk-table__cell">{{ row.updated }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="govuk-body">{{ copy.emptyState }}</p>
  {% endif %}
{% endblock %}
