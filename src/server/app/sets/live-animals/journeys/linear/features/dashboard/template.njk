{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{% block journeyContent %}
  {% if deletionSucceeded %}
    {{ govukNotificationBanner({
      type: "success",
      titleText: sharedCopy.notificationActions.delete.successTitle,
      text: sharedCopy.notificationActions.delete.successBody,
      role: "alert"
    }) }}
  {% endif %}

  {% if actionUnavailable %}
    {{ govukNotificationBanner({
      titleText: sharedCopy.notificationActions.unavailable[actionUnavailable].title,
      text: sharedCopy.notificationActions.unavailable.body,
      role: "alert"
    }) }}
  {% endif %}

  <h1 class="govuk-heading-xl">{{ copy.title }}</h1>
  <p class="govuk-body">{{ copy.body }}</p>

  <form method="post" action="{{ startAction }}" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    {{ govukButton({ text: copy.startButton, isStartButton: true }) }}
  </form>

  <h2 class="govuk-heading-m">{{ copy.notificationsHeading }}</h2>
  <div class="notification-list__layout">
    <aside class="notification-list__filters" aria-labelledby="filter-notifications-heading">
      <h3 class="govuk-heading-m" id="filter-notifications-heading">{{ copy.search.heading }}</h3>

      <form method="get" action="{{ listAction }}" class="notification-list__search-form" data-testid="notification-search-form">
        {% if sort %}
          <input type="hidden" name="sort" value="{{ sort }}" />
        {% endif %}
        {{ govukInput({
          id: "referenceNumber",
          name: "referenceNumber",
          label: {
            text: copy.search.label,
            classes: "govuk-label--s"
          },
          value: referenceNumber
        }) }}
        {{ govukButton({ text: copy.search.button }) }}
      </form>
    </aside>

    <div class="notification-list__main">
      <div class="notification-list__toolbar">
        <p class="govuk-label govuk-label--s notification-list__results">{{ resultsLabel }}</p>

        <form method="get" action="{{ listAction }}" class="notification-list__sort-form">
          {% if currentPage > 1 %}
            <input type="hidden" name="page" value="{{ currentPage }}" />
          {% endif %}
          {% if referenceNumber %}
            <input type="hidden" name="referenceNumber" value="{{ referenceNumber }}" />
          {% endif %}
          <div class="govuk-form-group govuk-!-width-auto">
            <label class="govuk-label govuk-label--s" for="sort">{{ copy.sort.label }}</label>
            <select class="govuk-select" id="sort" name="sort">
              {% for option in sortOptions %}
                <option value="{{ option.value }}" {% if option.value == sort %}selected{% endif %}>{{ option.text }}</option>
              {% endfor %}
            </select>
          </div>
          {{ govukButton({
            text: copy.sort.update,
            classes: "govuk-button--secondary"
          }) }}
        </form>
      </div>

      {% if notificationRows.length %}
        {% for row in notificationRows %}
          <div class="govuk-summary-card notification-list">
        <div class="govuk-summary-card__title-wrapper">
          <h3 class="govuk-summary-card__title">{{ row.reference }}</h3>
          <ul class="govuk-summary-card__actions">
            {% for action in row.actions %}
              <li class="govuk-summary-card__action">
                {% if action.postAction %}
                  <form method="post" action="{{ action.postAction }}" class="app-form-inline">
                    <input type="hidden" name="crumb" value="{{ crumb }}" />
                    {% if action.idempotencyKey %}
                      <input type="hidden" name="idempotencyKey" value="{{ action.idempotencyKey }}" />
                      <input type="hidden" name="copyOrigin" value="{{ action.copyOrigin }}" />
                    {% endif %}
                    <button type="submit" class="govuk-link app-link-button">
                      {{ action.text }}<span class="govuk-visually-hidden"> {{ copy.actionHidden(row.reference) }}</span>
                    </button>
                  </form>
                {% else %}
                  <a class="govuk-link" href="{{ action.href }}">
                    {{ action.text }}<span class="govuk-visually-hidden"> {{ copy.actionHidden(row.reference) }}</span>
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
        <div class="govuk-summary-card__content">
          <dl class="notification-list__grid-row">
            <div class="notification-list__grid-column-30">
              <dt class="notification-list__heading">{{ copy.table.commodity }}</dt>
              <dd class="notification-list__value">{{ row.commodity }}</dd>
            </div>
            <div class="notification-list__grid-column-30">
              <dt class="notification-list__heading">{{ copy.table.origin }}</dt>
              <dd class="notification-list__value">{{ row.origin }}</dd>
            </div>
            <div class="notification-list__grid-column-30">
              <dt class="notification-list__heading">{{ copy.table.arrival }}</dt>
              <dd class="notification-list__value">{{ row.arrival }}</dd>
            </div>
          </dl>
          <dl class="notification-list__grid-row">
            <div class="notification-list__grid-column-30">
              <dt class="notification-list__heading">{{ copy.table.consignee }}</dt>
              <dd class="notification-list__value">{{ row.consignee }}</dd>
            </div>
            <div class="notification-list__grid-column-30">
              <dt class="notification-list__heading">{{ copy.table.consignor }}</dt>
              <dd class="notification-list__value">{{ row.consignor }}</dd>
            </div>
            <div class="notification-list__grid-column-30">
              <dt class="notification-list__heading">{{ copy.table.status }}</dt>
              <dd class="notification-list__value">
                {{ govukTag({ text: row.status.text, classes: row.status.classes }) }}
              </dd>
            </div>
          </dl>
          <dl class="notification-list__grid-row">
            <div class="notification-list__grid-column-30">
              <dt class="notification-list__heading">{{ copy.table.created }}</dt>
              <dd class="notification-list__value">{{ row.created }}</dd>
            </div>
            <div class="notification-list__grid-column-30">
              <dt class="notification-list__heading">{{ copy.table.submitted }}</dt>
              <dd class="notification-list__value">{{ row.submitted }}</dd>
            </div>
          </dl>
        </div>
          </div>
        {% endfor %}
      {% elif not referenceNumber %}
        <p class="govuk-body">{{ copy.emptyText }}</p>
      {% endif %}

      {% if pagination %}
        {{ govukPagination(pagination) }}
      {% endif %}
    </div>
  </div>
{% endblock %}
