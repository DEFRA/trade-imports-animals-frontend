{% extends 'layouts/page.njk' %}

{% set pageTitle = pageTitle %}

{% block head %}
  {{ super() }}
  {# EUDPA-106 Option 3-with-callbacks: no-JS async poll of the backend list.
     The browser re-issues the GET on an interval; the handler checks whether
     the callback has landed by seeing if the notification has any docs. As
     soon as it does, the handler 302s to /accompanying-documents.

     Accessibility trade-off (deferred to EUDPA-296 dashboard rewrite):
     meta-refresh discards page context every {{ refreshIntervalSeconds }}s,
     so screen readers re-announce the whole document each tick and any
     focus/read-position is lost. The two escape hatches below ("Refresh
     now" and "continue without waiting") satisfy WCAG 2.2.1 Timing
     Adjustable at Level A/AA, but this page still fails 3.2.5 Change on
     Request (Level AAA). EUDPA-296 replaces this placeholder with a
     notification-level status dashboard where the meaningful content per
     tick makes progressive-enhancement JS polling with an aria-live tag
     region viable — that is where the a11y pass belongs. #}
  <meta http-equiv="refresh" content="{{ refreshIntervalSeconds }};url=/accompanying-documents/upload-successful?corr={{ correlationId }}&amp;attempt={{ nextAttempt }}">
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Uploading your file</h1>
      <p class="govuk-body">We're scanning your file for viruses. This page will refresh automatically.</p>
      <p class="govuk-body">
        <a href="/accompanying-documents/upload-successful?corr={{ correlationId }}&amp;attempt={{ nextAttempt }}" class="govuk-link">Refresh now</a>
        or
        <a href="/accompanying-documents" class="govuk-link">continue without waiting</a>
      </p>
    </div>
  </div>
{% endblock %}
