{% from "govuk/components/table/macro.njk" import govukTable %}

{# One row per selected commodity — or one per chosen species where the design
   lists a commodity's species individually: code, common name, Remove
   (design 01-14). #}
{% macro selectedCommoditiesTable(selectedRows, copy) %}
  {% set rows = [] %}
  {% for row in selectedRows %}
    {% set removeCell %}
      <button type="submit" class="govuk-link app-link-button" name="action" value="{{ row.removeAction }}">{{ copy.remove }}<span class="govuk-visually-hidden"> {{ row.name }}</span></button>
    {% endset %}
    {% set ignored = rows.push([
      { text: row.code },
      { text: row.name },
      { html: removeCell, classes: "govuk-!-text-align-right" }
    ]) %}
  {% endfor %}
  {{ govukTable({
    caption: copy.caption,
    captionClasses: "govuk-table__caption--m",
    head: [
      { text: copy.commodityCode },
      { text: copy.commonName },
      { html: '<span class="govuk-visually-hidden">' + copy.actionsHidden + '</span>' }
    ],
    rows: rows
  }) }}
{% endmacro %}
