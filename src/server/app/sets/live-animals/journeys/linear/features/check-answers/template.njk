{% extends "shared/layout.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% macro cardError(text) %}
  {% if text %}
    <p class="govuk-error-message">
      <span class="govuk-visually-hidden">{{ copy.errors.prefix }}</span> {{ text }}
    </p>
  {% endif %}
{% endmacro %}

{% macro cardActions(actions) %}
  {% if actions and actions.items.length %}
    <ul class="govuk-summary-card__actions">
      {% for item in actions.items %}
        <li class="govuk-summary-card__action">
          <a class="govuk-link" href="{{ item.href }}">{{ item.text }}<span class="govuk-visually-hidden"> {{ item.visuallyHiddenText }}</span></a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}

{% block journeyContent %}
  {% if amendmentCancelled %}
    {{ govukNotificationBanner({
      type: "success",
      titleText: copy.cancelAmend.successTitle,
      text: copy.cancelAmend.successBody,
      role: "alert"
    }) }}
  {% endif %}

  {% include "shared/error-summary.njk" %}

  {% if viewHeader %}
    <div class="govuk-!-margin-bottom-6">
      <h1 class="govuk-heading-l govuk-!-display-inline-block govuk-!-margin-right-2 govuk-!-margin-bottom-2">{{ viewHeader.reference }}</h1>
      {{ govukTag({ text: viewHeader.status.text, classes: viewHeader.status.classes }) }}
      {% if viewHeader.dateSubmitted %}<p class="govuk-body govuk-!-margin-bottom-0">{{ viewHeader.dateSubmitted }}</p>{% endif %}
      <form method="post" action="{{ viewHeader.actions.copyHref }}" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}" />
        <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
        <input type="hidden" name="copyOrigin" value="notification-view" />
        <div class="govuk-button-group govuk-!-margin-top-4">
          {% if viewHeader.actions.amendHref %}
            {{ govukButton({
              text: copy.viewHeader.amend,
              attributes: { formaction: viewHeader.actions.amendHref }
            }) }}
          {% endif %}
          {{ govukButton({
            text: sharedCopy.notificationActions.copy.text,
            classes: "" if viewHeader.actions.copyIsPrimary else "govuk-button--secondary"
          }) }}
          {{ govukButton({
            text: sharedCopy.notificationActions.delete.text,
            href: viewHeader.actions.deleteHref,
            classes: "govuk-button--warning"
          }) }}
        </div>
      </form>
      <section class="govuk-!-margin-bottom-6" aria-labelledby="import-reference-numbers">
        <h2 class="govuk-heading-m" id="import-reference-numbers">{{ copy.importReferences.heading }}</h2>
        {{ govukWarningText({
          text: copy.importReferences.warning,
          iconFallbackText: copy.importReferences.warningIcon
        }) }}
        {{ govukSummaryList({ rows: viewHeader.importReferences }) }}
      </section>
    </div>
  {% else %}
    <h1 class="govuk-heading-l">{{ heading }}</h1>
  {% endif %}

  {% set cardHeadingLevel = 3 %}
  {% set innerHeadingLevel = 4 %}
  {% set blockHeadingLevel = 5 %}
  {% for section in sections %}
    {% if not loop.first %}
      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
    {% endif %}
    <h2 class="govuk-heading-m" id="{{ section.anchor }}" tabindex="-1">{{ section.heading }}</h2>
    {% for card in section.cards %}
      {% if card.speciesBlocks or card.subsections or card.error %}
        <div class="govuk-summary-card{% if card.error %} app-summary-card--error{% endif %}"{% if card.anchor %} id="{{ card.anchor }}" tabindex="-1"{% endif %}>
          <div class="govuk-summary-card__title-wrapper">
            <h{{ cardHeadingLevel }} class="govuk-summary-card__title">{{ card.title }}</h{{ cardHeadingLevel }}>
            {{ cardActions(card.actions) }}
          </div>
          <div class="govuk-summary-card__content">
            {{ cardError(card.error) }}
            {% if card.rows.length %}
              {{ govukSummaryList({ rows: card.rows }) }}
            {% endif %}
            {% for subsection in card.subsections %}
              <h{{ innerHeadingLevel }} class="govuk-heading-s">{{ subsection.heading }}</h{{ innerHeadingLevel }}>
              {{ govukSummaryList({ rows: subsection.rows }) }}
            {% endfor %}
            {% for block in card.speciesBlocks %}
              <h{{ innerHeadingLevel }} class="govuk-heading-s" id="{{ block.anchor }}" tabindex="-1">{{ block.heading }}</h{{ innerHeadingLevel }}>
              {{ govukSummaryList({ rows: block.rows }) }}
              {% if block.identifierTable %}
                <h{{ blockHeadingLevel }} class="govuk-heading-s">{{ copy.identifierTable.heading }}</h{{ blockHeadingLevel }}>
                {% if block.identifierTable.actions %}
                  {% set identificationChange = block.identifierTable.actions.items[0] %}
                  <p class="govuk-body"><a class="govuk-link" href="{{ identificationChange.href }}">{{ identificationChange.text }}<span class="govuk-visually-hidden"> {{ identificationChange.visuallyHiddenText }}</span></a></p>
                {% endif %}
                {{ govukTable({ head: block.identifierTable.head, rows: block.identifierTable.rows }) }}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% else %}
        {{ govukSummaryList({
          card: {
            title: { text: card.title, headingLevel: cardHeadingLevel },
            actions: card.actions,
            attributes: { id: card.anchor, tabindex: "-1" } if card.anchor else null
          },
          rows: card.rows
        }) }}
      {% endif %}
    {% endfor %}
  {% endfor %}

  {# A submitted notification is a record, not a form. The read-only review has
     already dropped every Change link, so inviting the trader to submit again
     would offer the one action the page has otherwise taken away — and the
     declaration redirects a submitted journey to a confirmation it did not
     just produce. The read-only review ends with the last card. #}
  {% if not readOnly %}
    <form method="post" novalidate>
      <input type="hidden" name="crumb" value="{{ crumb }}" />
      <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
      <div class="govuk-button-group">
        {{ govukButton({ text: copy.submit.button }) }}
        {% if cancelAmendHref %}
          {{ govukButton({
            text: copy.cancelAmend.button,
            href: cancelAmendHref,
            classes: "govuk-button--secondary"
          }) }}
        {% endif %}
        {{ govukButton({
          text: sharedCopy.notificationActions.delete.text,
          href: deleteHref,
          classes: "govuk-button--warning"
        }) }}
      </div>
    </form>
  {% endif %}
{% endblock %}
