{% extends "shared/layout.njk" %}
{% from "accessible-autocomplete/macro.njk" import appAccessibleAutocomplete %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% macro revealAutocomplete(params) %}
  {{ appAccessibleAutocomplete({
    id: params.id,
    name: params.id,
    label: { text: params.copy.label, classes: "govuk-label--s" },
    value: params.values[params.id],
    errorMessage: params.errors[params.id] and { text: params.errors[params.id] },
    items: params.items,
    autocomplete: {
      showAllValues: true,
      noResults: params.copy.noResults,
      placeholder: params.copy.searchPlaceholder
    }
  }) }}
{% endmacro %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  {% set internalMarketReveal %}
    {{ govukRadios({
      name: "purposeInInternalMarket",
      fieldset: {
        legend: {
          text: copy.purpose.legend,
          classes: "govuk-fieldset__legend--m"
        }
      },
      errorMessage: errors.purposeInInternalMarket and { text: errors.purposeInInternalMarket },
      items: purposeOptions
    }) }}
  {% endset %}

  {% set transhipmentReveal %}
    {{ revealAutocomplete({ id: "transhipmentDestinationCountry", items: countryItems, values: values, errors: errors, copy: copy.country }) }}
  {% endset %}

  {% set transitReveal %}
    {{ revealAutocomplete({ id: "transitPortOfExit", items: portItems, values: values, errors: errors, copy: copy.port }) }}

    {{ revealAutocomplete({ id: "transitDestinationCountry", items: countryItems, values: values, errors: errors, copy: copy.country }) }}
  {% endset %}

  {% set temporaryAdmissionReveal %}
    {{ mojDatePicker(exitDateField) }}

    {{ revealAutocomplete({ id: "temporaryAdmissionPortOfExit", items: portItems, values: values, errors: errors, copy: copy.port }) }}
  {% endset %}

  {% set reveals = {
    internalMarket: internalMarketReveal,
    transhipmentOrOnwardTravel: transhipmentReveal,
    transit: transitReveal,
    temporaryAdmissionHorses: temporaryAdmissionReveal
  } %}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {{ govukRadios({
      name: "reasonForImport",
      fieldset: {
        legend: {
          text: copy.legend,
          classes: "govuk-visually-hidden"
        }
      },
      errorMessage: errors.reasonForImport and { text: errors.reasonForImport },
      items: withReveals(reasonOptions, reveals)
    }) }}

    {{ saveActions({ hubHref: hubHref, copy: sharedCopy.saveActions, amend: amend }) }}
  </form>
{% endblock %}
