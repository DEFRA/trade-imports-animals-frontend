{% extends "shared/layout.njk" %}
{% from "accessible-autocomplete/macro.njk" import appAccessibleAutocomplete %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {{ appAccessibleAutocomplete({
      id: "countryOfOrigin",
      name: "countryOfOrigin",
      label: { text: copy.country.label, classes: "govuk-label--m" },
      hint: { text: copy.country.hint },
      value: values.countryOfOrigin,
      errorMessage: errors.countryOfOrigin and { text: errors.countryOfOrigin },
      items: countryItems,
      autocomplete: { showAllValues: true, noResults: copy.country.noResults }
    }) }}

    {% set regionCodeHtml %}
      {{ govukInput({
        id: "regionOfOriginCodeSuffix",
        name: "regionOfOriginCodeSuffix",
        label: { text: copy.regionCode.label },
        hint: { text: copy.regionCode.hint },
        classes: "govuk-input--width-5",
        prefix: { text: regionCodePrefix },
        value: values.regionOfOriginCodeSuffix,
        errorMessage: errors.regionOfOriginCodeSuffix and { text: errors.regionOfOriginCodeSuffix }
      }) }}
    {% endset %}

    {{ govukRadios({
      name: "regionOfOriginCodeRequirement",
      fieldset: { legend: { text: copy.regionRequirement.legend, classes: "govuk-fieldset__legend--m" } },
      hint: { text: copy.regionRequirement.hint },
      items: [
        { value: "yes", text: copy.regionRequirement.yes, checked: values.regionOfOriginCodeRequirement == "yes", conditional: { html: regionCodeHtml } },
        { value: "no", text: copy.regionRequirement.no, checked: values.regionOfOriginCodeRequirement == "no" }
      ]
    }) }}

    {{ govukInput({
      id: "internalReferenceNumber",
      name: "internalReferenceNumber",
      label: { text: copy.internalReference.label, classes: "govuk-label--m" },
      hint: { text: copy.internalReference.hint },
      classes: "govuk-!-width-three-quarters",
      value: values.internalReferenceNumber,
      errorMessage: errors.internalReferenceNumber and { text: errors.internalReferenceNumber }
    }) }}

    {{ saveActions(hubHref, copy = sharedCopy.saveActions) }}
  </form>
{% endblock %}
