{% extends "shared/layout.njk" %}
{% from "accessible-autocomplete/macro.njk" import appAccessibleAutocomplete %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "live-animals/journeys/linear/features/transport/transit-countries/_added-countries-table.njk" import addedCountriesTable %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  <p class="govuk-body">{{ copy.betweenCountries }}</p>
  <p class="govuk-body">{{ copy.excludesUk }}</p>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {# The working list travels with the page. Add and Remove rebuild it and
       render it back; only Save and continue writes it. #}
    {% for code in selectedCountries %}
      <input type="hidden" name="transitedCountries" value="{{ code }}" />
    {% endfor %}

    {% if showCountryField %}
      {{ appAccessibleAutocomplete({
        id: "transitedCountry",
        name: "transitedCountry",
        label: { text: copy.country.label, classes: "govuk-label--s" },
        hint: { text: copy.country.hint },
        value: chosenValue,
        errorMessage: errors.transitedCountry and { text: errors.transitedCountry },
        items: countryItems,
        autocomplete: { showAllValues: true, noResults: copy.country.noResults, defaultValue: chosenLabel }
      }) }}

      {{ govukButton({
        text: copy.add,
        classes: "govuk-button--secondary",
        name: "action",
        value: "add"
      }) }}
    {% endif %}

    {% if atLimit %}
      <p class="govuk-body" id="transit-countries-limit">{{ limitMessage }}</p>
    {% endif %}

    {# The record of the answer, read back as a short list rather than as ticks
       down a long one (design release 1). #}
    {% if hasCountries %}
      {{ addedCountriesTable(countryRows, copy) }}
    {% else %}
      <p class="govuk-body">{{ copy.empty }}</p>
    {% endif %}

    {# Each addition and removal is announced as it happens, not left to be
       found in the table (design release 1). The message ships in the data
       attribute and is written in just after load: a region that already holds
       its text when the document is parsed is read as ordinary page content,
       not announced. #}
    <div id="transit-countries-status" class="govuk-visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-module="app-status-announcer" data-message="{{ status }}"></div>

    {{ saveActions(hubHref, copy = sharedCopy.saveActions) }}
  </form>
{% endblock %}
