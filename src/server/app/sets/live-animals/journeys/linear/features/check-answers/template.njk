{% extends "shared/layout.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% macro cardError(text) %}
  {% if text %}
    <p class="govuk-error-message">
      <span class="govuk-visually-hidden">{{ copy.errors.prefix }}</span> {{ text }}
    </p>
  {% endif %}
{% endmacro %}

{% macro actionLink(item) %}
  <a class="govuk-link" href="{{ item.href }}">{{ item.text }}<span class="govuk-visually-hidden"> {{ item.visuallyHiddenText }}</span></a>
{%- endmacro %}

{% macro cardActions(actions) %}
  {% if actions and actions.items.length %}
    <ul class="govuk-summary-card__actions">
      {% for item in actions.items %}
        <li class="govuk-summary-card__action">
          {{ actionLink(item) }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  <h1 class="govuk-heading-l">{{ heading }}</h1>

  {% if copyAction or deleteHref %}
    <div class="govuk-button-group">
      {% if copyAction %}
        <form method="post" action="{{ copyAction.href }}" class="app-form-inline">
          <input type="hidden" name="crumb" value="{{ crumb }}" />
          <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
          <input type="hidden" name="copyOrigin" value="notification-view" />
          {{ govukButton({
            text: sharedCopy.notificationActions.copy.text,
            classes: "govuk-button--secondary"
          }) }}
        </form>
      {% endif %}
      {% if deleteHref %}
        {{ govukButton({
          text: sharedCopy.notificationActions.delete.text,
          href: deleteHref,
          classes: "govuk-button--warning"
        }) }}
      {% endif %}
    </div>
  {% endif %}

  {% for section in sections %}
    {% if not loop.first %}
      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
    {% endif %}
    <h2 class="govuk-heading-m" id="{{ section.anchor }}" tabindex="-1">{{ section.heading }}</h2>
    {% for card in section.cards %}
      {% if card.speciesBlocks.length or card.groups.length or card.error %}
        <div class="govuk-summary-card{% if card.error %} app-summary-card--error{% endif %}"{% if card.anchor %} id="{{ card.anchor }}" tabindex="-1"{% endif %}>
          <div class="govuk-summary-card__title-wrapper">
            <h3 class="govuk-summary-card__title">{{ card.title }}</h3>
            {{ cardActions(card.actions) }}
          </div>
          <div class="govuk-summary-card__content">
            {{ cardError(card.error) }}
            {% if card.rows.length %}
              {{ govukSummaryList({ rows: card.rows }) }}
            {% endif %}
            {% for block in card.speciesBlocks %}
              <div id="{{ block.anchor }}" tabindex="-1">
                <h4 class="govuk-heading-s">{{ block.heading }}</h4>
                {{ govukSummaryList({ rows: block.rows }) }}
                {% if block.identificationDetails %}
                  <h5 class="govuk-heading-xs">{{ copy.identificationDetails.heading }}</h5>
                  {% if block.identificationDetails.actions %}
                    <p class="govuk-body">
                      {% for item in block.identificationDetails.actions.items %}
                        {{ actionLink(item) }}
                      {% endfor %}
                    </p>
                  {% endif %}
                  {{ govukTable({
                    head: block.identificationDetails.table.head,
                    rows: block.identificationDetails.table.rows
                  }) }}
                {% endif %}
              </div>
            {% endfor %}
            {% for group in card.groups %}
              <h4 class="govuk-heading-s">{{ group.heading }}</h4>
              {{ govukSummaryList({ rows: group.rows }) }}
            {% endfor %}
          </div>
        </div>
      {% else %}
        {{ govukSummaryList({
          card: {
            title: { text: card.title, headingLevel: 3 },
            actions: card.actions,
            attributes: { id: card.anchor, tabindex: "-1" } if card.anchor else null
          },
          rows: card.rows
        }) }}
      {% endif %}
    {% endfor %}
  {% endfor %}

  {% if not readOnly %}
    <form method="post" action="{{ declarationHref }}" novalidate>
      <input type="hidden" name="crumb" value="{{ crumb }}" />
      <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
      <input type="hidden" name="step" value="review" />
      {{ govukButton({ text: copy.submit.button }) }}
    </form>
  {% endif %}
{% endblock %}
