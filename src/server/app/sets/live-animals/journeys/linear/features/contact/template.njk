{% extends "shared/layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "shared/save-actions.njk" import saveActions %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  <p class="govuk-body">{{ copy.intro }}</p>

  <h2 class="govuk-heading-m">{{ resultsHeading }}</h2>

  {% if addAddressHref %}
    <p class="govuk-body">{{ copy.addNewBranchAddress.before }}<a class="govuk-link" href="{{ addAddressHref }}">{{ copy.addNewBranchAddress.linkText }}</a>{{ copy.addNewBranchAddress.after }}</p>
  {% endif %}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {{ govukRadios({
      name: "contactAddress",
      fieldset: {
        legend: {
          text: resultsHeading,
          classes: "govuk-visually-hidden"
        }
      },
      errorMessage: errors.contactAddress and { text: errors.contactAddress },
      items: contactOptions
    }) }}

    {{ saveActions({ hubHref: hubHref, copy: sharedCopy.saveActions }) }}
  </form>
{% endblock %}
