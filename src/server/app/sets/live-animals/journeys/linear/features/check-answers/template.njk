{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "live-animals/journeys/linear/features/check-answers/_review-sections.njk" import reviewSections %}

{% block journeyContent %}
  {% if amendmentCancelled %}
    {{ govukNotificationBanner({
      type: "success",
      titleText: copy.cancelAmend.successTitle,
      text: copy.cancelAmend.successBody,
      role: "alert"
    }) }}
  {% endif %}

  {% include "shared/error-summary.njk" %}

  <h1 class="govuk-heading-l">{{ heading }}</h1>

  {% if copyAction or deleteHref %}
    <div class="govuk-button-group">
      {% if copyAction %}
        <form method="post" action="{{ copyAction.href }}" class="app-form-inline">
          <input type="hidden" name="crumb" value="{{ crumb }}" />
          <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
          <input type="hidden" name="copyOrigin" value="notification-view" />
          {{ govukButton({
            text: sharedCopy.notificationActions.copy.text,
            classes: "govuk-button--secondary"
          }) }}
        </form>
      {% endif %}
      {% if deleteHref %}
        {{ govukButton({
          text: sharedCopy.notificationActions.delete.text,
          href: deleteHref,
          classes: "govuk-button--warning"
        }) }}
      {% endif %}
    </div>
  {% endif %}

  {% if cancelAmendHref %}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ cancelAmendHref }}">{{ copy.cancelAmend.link }}</a>
    </p>
  {% endif %}

  {{ reviewSections(sections, copy) }}

  {# A submitted notification is a record, not a form. The read-only review has
     already dropped every Change link, so inviting the trader to submit again
     would offer the one action the page has otherwise taken away — and the
     declaration redirects a submitted journey to a confirmation it did not
     just produce. The read-only review ends with the last card. #}
  {% if not readOnly %}
    <form method="post" novalidate>
      <input type="hidden" name="crumb" value="{{ crumb }}" />
      <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
      {{ govukButton({ text: submitText }) }}
    </form>
  {% endif %}
{% endblock %}
