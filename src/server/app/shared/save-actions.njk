{% from "govuk/components/button/macro.njk" import govukButton %}

{# The one place a journey page's ending is stated.

   The rule: a page the hub links to directly ends with all three controls —
   the primary and "Save and return to overview" side by side, then "Cancel and
   return to overview" on its own line below them — so a trader can stop and
   leave from where the hub sent them. The
   two return controls name the page they lead to, which is headed "Overview";
   "hub" is the internal name for it and never appears on screen. A page reached
   from another page ends with the primary alone, and the trader leaves the way
   they came in. Pass `showReturnControls = false` on those. A page with no
   overview link (`hubHref`) also ends with the primary alone.

   While a notification is being amended, a page passes `amend` (the pair of
   form actions from `amendFormActions`) and ends instead with "Save and
   return" (back to the review, the real service's own `?change=1`) and "Save
   and continue" (on, never back to the review) side by side, then a secondary
   "Save and return to overview" button on its own line below them, with no
   cancel link. Each save button carries its own `formaction`, so no new field
   is posted. A page reached from another page (`showReturnControls = false`)
   or a picker (`hubExitWhileAmending = false`) ends with the first two only.

   A page changing one section of a saved template ends with "Save and return"
   and a "Cancel" link to the template's page, and nothing else; this ending
   takes precedence over the others. Pass `templateChange`. #}
{% macro saveActions(hubHref, primary, copy, showReturnControls = true, amend = none, hubExitWhileAmending = true, templateChange = false) %}
  {% set returnControls = showReturnControls and hubHref %}
  {% if templateChange %}
    <div class="govuk-button-group">
      {{ govukButton({
        text: copy.saveAndReturn,
        name: primary.name if primary else none,
        value: primary.value if primary else none
      }) }}
      <a class="govuk-link" href="{{ hubHref }}">{{ copy.cancel }}</a>
    </div>
  {% else %}
    <div class="govuk-button-group">
      {% if amend %}
        {{ govukButton({
          text: copy.saveAndReturn,
          name: primary.name if primary,
          value: primary.value if primary,
          attributes: { formaction: amend.returnAction }
        }) }}
        {{ govukButton({
          text: copy.saveAndContinue,
          classes: "govuk-button--secondary",
          name: primary.name if primary,
          value: primary.value if primary,
          attributes: { formaction: amend.continueAction }
        }) }}
      {% else %}
        {{ govukButton(primary or { text: copy.saveAndContinue }) }}
        {% if returnControls %}
          {{ govukButton({
            text: copy.saveAndReturnToHub,
            classes: "govuk-button--secondary",
            name: "exit",
            value: "hub"
          }) }}
        {% endif %}
      {% endif %}
    </div>
    {% if amend %}
      {% if returnControls and hubExitWhileAmending %}
        {{ govukButton({
          text: copy.saveAndReturnToHub,
          classes: "govuk-button--secondary",
          name: "exit",
          value: "hub"
        }) }}
      {% endif %}
    {% elif returnControls %}
      <p class="govuk-body">
        <a class="govuk-link" href="{{ hubHref }}">{{ copy.cancelAndReturnToHub }}</a>
      </p>
    {% endif %}
  {% endif %}
{% endmacro %}
