{% extends "shared/layout.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% macro cardError(text) %}
  {% if text %}
    <p class="govuk-error-message">
      <span class="govuk-visually-hidden">{{ copy.errors.prefix }}</span> {{ text }}
    </p>
  {% endif %}
{% endmacro %}

{% macro actionLink(item, cardTitle) %}
  <a class="govuk-link" href="{{ item.href }}">{{ item.text }}<span class="govuk-visually-hidden"> {{ item.visuallyHiddenText }}</span>{% if cardTitle %}<span class="govuk-visually-hidden"> ({{ cardTitle }})</span>{% endif %}</a>
{%- endmacro %}

{% macro cardActions(actions, cardTitle) %}
  {% if actions and actions.items.length %}
    <ul class="govuk-summary-card__actions">
      {% for item in actions.items %}
        <li class="govuk-summary-card__action">
          {{ actionLink(item, cardTitle) }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {% if viewHeader %}
    <h1 class="govuk-heading-l govuk-!-display-inline-block govuk-!-margin-right-3">{{ viewHeader.reference }}</h1>
    {{ govukTag({ text: viewHeader.status.text, classes: viewHeader.status.classes }) }}

    <div class="govuk-button-group">
      {% if viewHeader.actions.amend %}
        <form method="post" action="{{ viewHeader.actions.amend.postAction }}" class="app-form-inline">
          <input type="hidden" name="crumb" value="{{ crumb }}" />
          {{ govukButton({ text: viewHeader.actions.amend.text }) }}
        </form>
      {% endif %}
      <form method="post" action="{{ viewHeader.actions.copy.postAction }}" class="app-form-inline">
        <input type="hidden" name="crumb" value="{{ crumb }}" />
        <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
        <input type="hidden" name="copyOrigin" value="notification-view" />
        {{ govukButton({
          text: viewHeader.actions.copy.text,
          classes: viewHeader.actions.copy.classes
        }) }}
      </form>
      {{ govukButton(viewHeader.actions.delete) }}
    </div>

    {% if viewHeader.dateLine %}
      <p class="govuk-body">{{ viewHeader.dateLine }}</p>
    {% endif %}

    <section aria-labelledby="import-reference-numbers-heading">
      <h2 class="govuk-heading-m" id="import-reference-numbers-heading">{{ viewHeader.importReferences.heading }}</h2>
      {{ govukWarningText(viewHeader.importReferences.warning) }}
      {{ govukSummaryList({ rows: viewHeader.importReferences.rows }) }}
    </section>
    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
  {% else %}
    <h1 class="govuk-heading-l">{{ heading }}</h1>
  {% endif %}

  {% for section in sections %}
    {% if not loop.first %}
      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
    {% endif %}
    <h2 class="govuk-heading-m" id="{{ section.anchor }}" tabindex="-1">{{ section.heading }}</h2>
    {% for card in section.cards %}
      {% set cardTitleId = section.anchor + '-card-' + loop.index + '-title' %}
      <section class="govuk-summary-card{% if card.error %} app-summary-card--error{% endif %}"{% if card.anchor %} id="{{ card.anchor }}" tabindex="-1"{% endif %} aria-labelledby="{{ cardTitleId }}">
        <div class="govuk-summary-card__title-wrapper">
          <h3 class="govuk-summary-card__title" id="{{ cardTitleId }}">{{ card.title }}</h3>
          {{ cardActions(card.actions, card.title) }}
        </div>
        <div class="govuk-summary-card__content">
          {{ cardError(card.error) }}
          {% if card.rows.length %}
            {{ govukSummaryList({ rows: card.rows }) }}
          {% endif %}
          {% for block in card.speciesBlocks %}
            <div id="{{ block.anchor }}" tabindex="-1">
              <h4 class="govuk-heading-s">{{ block.heading }}</h4>
              {{ govukSummaryList({ rows: block.rows }) }}
              {% if block.identificationDetails %}
                <h5 class="govuk-heading-s">{{ copy.identificationDetails.heading }}</h5>
                {% if block.identificationDetails.actions %}
                  <p class="govuk-body">
                    {% for item in block.identificationDetails.actions.items %}
                      {{ actionLink(item) }}
                    {% endfor %}
                  </p>
                {% endif %}
                {{ govukTable({
                  head: block.identificationDetails.table.head,
                  rows: block.identificationDetails.table.rows
                }) }}
              {% endif %}
            </div>
          {% endfor %}
          {% for group in card.groups %}
            <h4 class="govuk-heading-s">{{ group.heading }}</h4>
            {{ govukSummaryList({ rows: group.rows }) }}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  {% endfor %}

  {% if not readOnly %}
    <form method="post" action="{{ declarationHref }}" novalidate>
      <input type="hidden" name="crumb" value="{{ crumb }}" />
      <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
      <input type="hidden" name="step" value="review" />
      <div class="govuk-button-group">
        {{ govukButton({ text: copy.submit.button }) }}
        {% if cancelAmendButton %}
          {{ govukButton(cancelAmendButton) }}
        {% endif %}
        {% if deleteButton %}
          {{ govukButton(deleteButton) }}
        {% endif %}
      </div>
    </form>
  {% endif %}
{% endblock %}
