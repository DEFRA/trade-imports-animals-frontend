{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  <p class="govuk-body">{{ copy.intro }}</p>

  <p class="govuk-body">{{ copy.guidance.authorisationLead }}</p>
  <ul class="govuk-list govuk-list--bullet govuk-list--spaced">
    {% for condition in copy.guidance.authorisationConditions %}
      <li>{{ condition }}</li>
    {% endfor %}
  </ul>
  <p class="govuk-body">
    <a href="{{ copy.guidance.linkHref }}" class="govuk-link" rel="noreferrer noopener" target="_blank">{{ copy.guidance.linkText }}</a>
  </p>
  <p class="govuk-body">{{ copy.guidance.daeraValid }}</p>
  <p class="govuk-body">{{ copy.guidance.euNotValid }}</p>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {# Design release 1 aligns the transporters into headed columns rather than
       running each one's facts together in a radio hint, with the radio that
       picks a row in the leading column — the same shape as the address
       picker's results table. Names are escaped into the hidden label because
       a transporter name may carry an ampersand. #}
    {% set transporterTableRows = [] %}
    {% for row in transporterRows %}
      {% set selectCell %}
        {{ govukRadios({
          idPrefix: row.idPrefix,
          name: "transporter",
          classes: "govuk-radios--small",
          items: [{
            value: row.id,
            html: '<span class="govuk-visually-hidden">' + copy.selectRowPrefix + " " + (row.name | escape) + '</span>',
            checked: row.checked
          }]
        }) }}
      {% endset %}
      {% set statusCell %}
        {{ govukTag({ text: row.status.text, classes: row.status.classes }) }}
      {% endset %}
      {% set ignored = transporterTableRows.push([
        { html: selectCell },
        { text: row.name },
        { text: row.addressText },
        { text: row.approvalNumber },
        { text: row.type },
        { html: statusCell }
      ]) %}
    {% endfor %}

    {% set transporterListHtml %}
      {% if errors.transporter %}
        {{ govukErrorMessage({ id: "transporter-error", text: errors.transporter }) }}
      {% endif %}

      {{ govukTable({
        head: [
          { html: '<span class="govuk-visually-hidden">' + copy.table.selectHidden + '</span>' },
          { text: copy.table.name },
          { text: copy.table.address },
          { text: copy.table.approvalNumber },
          { text: copy.table.type },
          { text: copy.table.status }
        ],
        rows: transporterTableRows
      }) }}
    {% endset %}

    <div class="govuk-form-group{{ ' govuk-form-group--error' if errors.transporter }}">
      {{ govukFieldset({
        legend: {
          text: copy.legend,
          classes: "govuk-fieldset__legend--m"
        },
        describedBy: "transporter-error" if errors.transporter else "",
        html: transporterListHtml
      }) }}
    </div>

    {# The way out of the list for a trader whose transporter is not on it. #}
    {{ govukButton({
      text: copy.add,
      href: addHref,
      classes: "govuk-button--secondary"
    }) }}

    {{ saveActions(hubHref, copy = sharedCopy.saveActions) }}
  </form>
{% endblock %}
