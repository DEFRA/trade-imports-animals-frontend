{% extends "shared/layout.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "live-animals/journeys/linear/features/commodities/animal-identification/_identification-card.njk" import identificationCard %}
{% from "live-animals/journeys/linear/features/commodities/animal-identification/_selected-commodities-summary.njk" import selectedCommoditiesSummary %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  {{ govukInsetText({
    text: copy.inset
  }) }}

  {# A page with no identifiable line never renders: the controller carries the request on instead. #}
  {{ selectedCommoditiesSummary(selectedCommodities, addHref, copy.summary) }}

  <p class="govuk-body">
    <a class="govuk-link" href="{{ addHref }}">{{ copy.addAnotherCommodity }}</a>
  </p>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    <button type="submit" name="action" value="finish" class="govuk-visually-hidden" aria-hidden="true" tabindex="-1">{{ copy.saveAndFinish }}</button>

    {% for card in cards %}
      {{ identificationCard(card, copy) }}
    {% endfor %}

    {{ saveActions(hubHref, copy = sharedCopy.saveActions) }}
  </form>
{% endblock %}
