{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "live-animals/journeys/linear/features/commodities/animal-identification/_saved-animals-table.njk" import savedAnimalsTable %}

{# One card per species line (design 01-16/17): the entered-identifiers
   table with per-row Remove, then the counter-driven entry form for the NEXT
   record — replaced by the maximum-reached state at N = M. #}
{% macro identificationCard(card, copy) %}
  <section id="{{ card.anchor }}" class="govuk-!-margin-bottom-6">
    <h2 class="govuk-heading-m govuk-!-margin-bottom-2">{{ card.title }}</h2>

    {# The counter below is the only mention of the number the trader is held
       to, so the way to correct that number sits beside it. #}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ card.changeCountHref }}">{{ copy.changeAnimalCount }}<span class="govuk-visually-hidden"> {{ card.title }}</span></a>
    </p>

    {% if card.hasUnits %}
      {{ savedAnimalsTable(card, copy) }}
    {% endif %}

    {% if card.atMax %}
      <p class="govuk-body">{{ card.maxReachedText }}</p>
    {% else %}
      <h3 class="govuk-heading-s">{{ card.counter }}</h3>

      {% for field in card.fields %}
        {{ govukInput({
          id: field.id,
          name: field.id,
          label: { text: field.label, classes: "govuk-label--s" },
          hint: field.hint and { text: field.hint },
          classes: "govuk-input--width-20",
          value: field.value,
          errorMessage: field.error and { text: field.error }
        }) }}
      {% endfor %}

      {% if card.showAddress %}
        {# Design release 1 puts the fraud warning and the definition of a
           permanent address above the question, because the reason the
           address matters — APHA checks it — is what stops an invented one. #}
        {{ govukWarningText({ text: copy.permanentAddress.warning }) }}

        <p class="govuk-body">{{ copy.permanentAddress.definitionLeadIn }}</p>
        <ul class="govuk-list govuk-list--bullet">
          {% for item in copy.permanentAddress.definitionItems %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>

        <h3 class="govuk-heading-s">{{ copy.permanentAddress.question }}</h3>

        {% for field in card.addressFields %}
          {{ govukInput({
            id: field.id,
            name: field.id,
            label: { text: field.label },
            type: field.type,
            classes: field.classes,
            autocomplete: field.autocomplete,
            value: field.value,
            errorMessage: field.error and { text: field.error }
          }) }}
        {% endfor %}
      {% endif %}

      {{ govukButton({
        text: copy.saveAndAddAnother,
        classes: "govuk-button--secondary",
        name: "action",
        value: "add:" ~ card.index
      }) }}
    {% endif %}
  </section>
  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />
{% endmacro %}
