{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "live-animals/journeys/linear/features/commodities/animal-identification/_saved-animals-table.njk" import savedAnimalsTable %}

{% macro identificationCard(card, copy) %}
  <section id="{{ card.anchor }}" class="govuk-summary-card" aria-labelledby="{{ card.anchor }}-title">
    <div class="govuk-summary-card__title-wrapper">
      <h3 class="govuk-summary-card__title" id="{{ card.anchor }}-title">{{ card.title }}</h3>
      <ul class="govuk-summary-card__actions">
        <li class="govuk-summary-card__action">
          <a class="govuk-link" href="{{ card.changeCountHref }}">{{ copy.changeAnimalCount }}<span class="govuk-visually-hidden"> {{ card.title }}</span></a>
        </li>
      </ul>
    </div>
    <div class="govuk-summary-card__content">
      {% if card.counter %}
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-two-thirds">
            <h4 class="govuk-heading-s">{{ card.counter }}</h4>

            {% for field in card.fields %}
              {{ govukInput({
                id: field.id,
                name: field.id,
                label: { text: field.label },
                classes: "govuk-input--width-20",
                value: field.value,
                errorMessage: field.error and { text: field.error }
              }) }}
            {% endfor %}

            {% if card.showAddress %}
              {{ govukWarningText({ text: copy.permanentAddress.warning }) }}

              <p class="govuk-body">{{ copy.permanentAddress.definitionLeadIn }}</p>
              <ul class="govuk-list govuk-list--bullet">
                {% for item in copy.permanentAddress.definitionItems %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>

              <h4 class="govuk-heading-s">{{ copy.permanentAddress.question }}</h4>

              {% for field in card.addressFields %}
                {{ govukInput({
                  id: field.id,
                  name: field.id,
                  label: { text: field.label },
                  hint: field.hint and { text: field.hint },
                  type: field.type,
                  classes: field.classes,
                  autocomplete: field.autocomplete,
                  value: field.value,
                  errorMessage: field.error and { text: field.error }
                }) }}
              {% endfor %}
            {% endif %}

            {% if card.saveButtonText %}
              {{ govukButton({
                text: card.saveButtonText,
                name: "action",
                value: "add:" ~ card.index
              }) }}
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if card.overCountText %}
        <p class="govuk-body">{{ card.overCountText }}</p>
      {% endif %}

      {% if card.hasUnits %}
        {{ savedAnimalsTable(card) }}
      {% endif %}
    </div>
  </section>
{% endmacro %}
