{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  {{ govukInsetText({
    text: copy.inset
  }) }}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {% for key in carriedKeys %}
      <input type="hidden" name="selection" value="{{ key }}" />
    {% endfor %}

    {{ govukInput({
      id: "commoditySearch",
      name: "commoditySearch",
      type: "search",
      label: { text: copy.searchLabel, classes: "govuk-label--m" },
      hint: { text: copy.searchHint },
      classes: "govuk-!-width-three-quarters",
      value: query,
      errorMessage: errors.commoditySearch and { text: errors.commoditySearch }
    }) }}

    {{ govukButton({
      text: copy.searchButton,
      classes: "govuk-button--secondary",
      name: "action",
      value: "search"
    }) }}

    {% if commodityGroups.length %}
      <div>
        {% for group in commodityGroups %}
          {{ govukCheckboxes({
            idPrefix: "species" if loop.first else "species-group-" + loop.index,
            name: "species",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { html: group.legendHtml, classes: "govuk-fieldset__legend--s" } },
            items: group.items
          }) }}
        {% endfor %}
      </div>
    {% elif noResults %}
      <p class="govuk-body">{{ copy.noResults }}</p>
    {% endif %}

    {% if selectedSummary.count %}
      <div id="commodity-selection">
        <h2 class="govuk-heading-s">{{ selectedSummary.heading }}</h2>
        {% for group in selectedSummary.groups %}
          <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ group.legend }}:</p>
          <ul class="govuk-list govuk-!-margin-bottom-4">
            {% for item in group.items %}
              <li>
                {{ item.label }}
                {{ item.removeHtml | safe }}
              </li>
            {% endfor %}
          </ul>
        {% endfor %}
        {{ govukButton({
          text: copy.selected.clearAll,
          classes: "govuk-button--secondary",
          name: "action",
          value: "clear"
        }) }}
      </div>
    {% endif %}

    {% set helpHtml %}
      <p class="govuk-body">{{ copy.help.reference }}</p>
      <p class="govuk-body">{{ copy.help.describes }}</p>
      <p class="govuk-body">{{ copy.help.lookupPrefix }} <a href="{{ copy.help.lookupHref }}" class="govuk-link" rel="noreferrer noopener" target="_blank">{{ copy.help.lookupLink }}<br>{{ copy.help.lookupNewTab }}</a>.</p>
    {% endset %}

    {{ govukDetails({
      summaryText: copy.help.summary,
      html: helpHtml
    }) }}

    {{ saveActions({ hubHref: hubHref, copy: sharedCopy.saveActions, amend: amend }) }}
  </form>
{% endblock %}
