{% extends "shared/layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "shared/save-actions.njk" import saveActions %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {% if addAddressHref %}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ addAddressHref }}">{{ addNewAddressLabel }}</a>
    </p>
  {% endif %}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {{ govukRadios({
      name: "contactAddress",
      fieldset: {
        legend: {
          text: copy.legend,
          isPageHeading: true,
          classes: "govuk-fieldset__legend--l"
        }
      },
      hint: { text: copy.hint },
      errorMessage: errors.contactAddress and { text: errors.contactAddress },
      items: contactOptions
    }) }}

    {# Below the radios so the page heading (the legend) stays the first heading. #}
    {% if currentContact %}
      {{ govukSummaryList({
        card: {
          title: { text: copy.current.title },
          attributes: { role: "region", "aria-label": copy.current.title }
        },
        rows: [
          {
            key: { text: currentContact.name },
            value: { text: currentContact.summary },
            actions: {
              items: [
                {
                  href: currentContact.editHref,
                  text: copy.current.editDetails,
                  visuallyHiddenText: copy.current.title | lower
                }
              ]
            }
          }
        ]
      }) }}
    {% endif %}

    {{ saveActions(hubHref, copy = sharedCopy.saveActions) }}
  </form>
{% endblock %}
