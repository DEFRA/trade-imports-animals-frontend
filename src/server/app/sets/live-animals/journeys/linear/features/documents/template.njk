{% extends "shared/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div id="js-error-summary-container"
           data-error-summary-title="{{ sharedCopy.errorSummary.title }}"
           data-error-prefix="{{ copy.errors.hiddenPrefix }}">
        {% include "shared/error-summary.njk" %}
      </div>

      {{ sectionCaption(caption) }}
      <h1 class="govuk-heading-l">{{ copy.title }}</h1>

      <p class="govuk-body">{{ copy.guidance.intro }}</p>
      <p class="govuk-body">{{ copy.guidance.otherDocumentsLead }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for document in copy.guidance.otherDocuments %}
          <li>{{ document }}</li>
        {% endfor %}
      </ul>

      {% set additionalDocumentsHtml %}
        {{ govukTable({
          caption: copy.guidance.additional.caption,
          captionClasses: "govuk-visually-hidden",
          head: [
            { text: copy.guidance.additional.consignment },
            { text: copy.guidance.additional.documentsNeeded }
          ],
          rows: additionalDocumentRows
        }) }}
        <p class="govuk-body">
          <a href="{{ copy.guidance.additional.linkHref }}" class="govuk-link" rel="noreferrer noopener" target="_blank">{{ copy.guidance.additional.linkText }}</a>
        </p>
      {% endset %}

      {{ govukDetails({
        summaryText: copy.guidance.additional.summary,
        html: additionalDocumentsHtml
      }) }}
    </div>
  </div>

  <form method="post" enctype="multipart/form-data" novalidate
        data-max-file-size="{{ maxFileSize }}"
        data-oversize-error="{{ oversizeFileMessage }}">
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />
    {% if pendingDocumentSave %}
      <input type="hidden" name="retryUploadId" value="{{ pendingDocumentSave.uploadId }}" />
      <input type="hidden" name="retryFilename" value="{{ pendingDocumentSave.filename }}" />
    {% endif %}
    {% if pendingDocumentRemoval %}
      <input type="hidden" name="retryRemoveIndex" value="{{ pendingDocumentRemoval.index }}" />
      <input type="hidden" name="retryRemoveUploadId" value="{{ pendingDocumentRemoval.uploadId }}" />
    {% endif %}

    <section class="govuk-summary-card" aria-labelledby="file-upload-heading">
      <div class="govuk-summary-card__title-wrapper">
        <h2 class="govuk-summary-card__title" id="file-upload-heading">{{ copy.fileUploadHeading }}</h2>
      </div>
      <div class="govuk-summary-card__content">
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-two-thirds">
            {{ govukInput({
              id: "accompanyingDocumentReference",
              name: "accompanyingDocumentReference",
              label: { text: copy.reference.label, classes: "govuk-label--s" },
              classes: "govuk-input--width-20",
              value: values.accompanyingDocumentReference,
              errorMessage: errors.accompanyingDocumentReference and { text: errors.accompanyingDocumentReference }
            }) }}

            {{ govukSelect({
              id: "accompanyingDocumentType",
              name: "accompanyingDocumentType",
              label: { text: copy.documentType.label, classes: "govuk-label--s" },
              value: values.accompanyingDocumentType,
              items: documentTypeItems,
              errorMessage: errors.accompanyingDocumentType and { text: errors.accompanyingDocumentType }
            }) }}

            {{ mojDatePicker(dateOfIssue) }}

            {%- set fileHintHtml -%}
              <p class="govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ copy.file.mustBe }}</p>
              <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
                <li>{{ copy.file.smallerThan(maxFileSizeLabel) }}</li>
                <li>{{ copy.file.allowedTypes(allowedFileTypesHint) }}</li>
                <li>{{ copy.file.upToMaximum(maxDocuments) }}</li>
                <li>{{ copy.file.noZipFiles }}</li>
              </ul>
            {%- endset -%}

            {{ govukFileUpload({
              id: "file",
              name: "file",
              label: { text: copy.file.label, classes: "govuk-label--s" },
              hint: { html: fileHintHtml },
              attributes: { accept: acceptAttribute },
              javascript: true,
              chooseFilesButtonText: copy.file.chooseButton,
              dropInstructionText: copy.file.dropInstruction,
              noFileChosenText: copy.file.noFileChosen,
              enteredDropZoneText: copy.file.enteredDropZone,
              leftDropZoneText: copy.file.leftDropZone,
              errorMessage: errors.file and { text: errors.file }
            }) }}

            {{ govukButton({
              text: copy.addAnother,
              classes: "govuk-button--secondary",
              name: "action",
              value: "add"
            }) }}
          </div>
        </div>

        {% if hasDocuments %}
          <div id="documents-added">
            {{ govukTable({
              caption: copy.table.caption,
              captionClasses: "govuk-visually-hidden",
              head: [
                { text: copy.table.reference },
                { text: copy.table.type },
                { text: copy.table.dateOfIssue },
                { text: copy.table.status },
                { html: '<span class="govuk-visually-hidden">' + copy.table.actionsHidden + '</span>', format: "numeric" }
              ],
              rows: rows
            }) }}
          </div>
          {% if anyPending %}
            <p id="js-refresh-fallback" class="govuk-body">
              <a href="{{ refreshHref }}" class="govuk-link">{{ copy.refreshStatus }}</a>
            </p>
          {% endif %}
          <p id="js-timeout-message" class="govuk-hint" {% if not timedOut %}hidden{% endif %}>{{ copy.stillChecking }}</p>
        {% endif %}
      </div>
    </section>

    {{ saveActions(hubHref, { text: sharedCopy.saveActions.saveAndContinue, name: "action", value: "continue" }, sharedCopy.saveActions, amend = amend) }}
  </form>

  <div id="js-scan-status-announcer"
       class="govuk-visually-hidden"
       aria-live="polite"
       aria-atomic="true"
       data-settled-href="{{ refreshHref }}"
       data-scan-copy="{{ scanCopyJson }}"></div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script type="module" src="{{ getAssetPath('documents.js') }}"></script>
{% endblock %}
