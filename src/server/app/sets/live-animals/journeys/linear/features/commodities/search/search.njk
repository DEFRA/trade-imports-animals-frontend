{% extends "shared/layout.njk" %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "live-search/macro.njk" import appLiveSearch %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  {{ govukInsetText({
    text: copy.inset
  }) }}

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {% call appLiveSearch({
      input: {
        id: "commoditySearch",
        name: "commoditySearch",
        label: { text: copy.searchLabel, classes: "govuk-label--m" },
        hint: { text: copy.searchHint },
        value: query,
        errorMessage: errors.commoditySearch and { text: errors.commoditySearch }
      },
      width: "govuk-!-width-three-quarters",
      button: { text: copy.searchButton, name: "action", value: "search" },
      resultsHref: resultsHref,
      resultsId: "commodity-search-results",
      status: resultStatus
    }) %}
      {% include "live-animals/journeys/linear/features/commodities/search/_results.njk" %}
    {% endcall %}

    {% set helpHtml %}
      <p class="govuk-body">{{ copy.help.reference }}</p>
      <p class="govuk-body">{{ copy.help.describes }}</p>
      <p class="govuk-body">{{ copy.help.lookupPrefix }} <a href="{{ copy.help.lookupHref }}" class="govuk-link" rel="noreferrer noopener" target="_blank">{{ copy.help.lookupLink }}</a>.</p>
    {% endset %}

    {{ govukDetails({
      summaryText: copy.help.summary,
      html: helpHtml
    }) }}

    {{ saveActions(hubHref, copy = sharedCopy.saveActions, amend = amend) }}
  </form>
{% endblock %}
