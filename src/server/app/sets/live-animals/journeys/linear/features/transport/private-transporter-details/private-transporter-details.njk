{% extends "shared/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "shared/save-actions.njk" import saveActions %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  {{ sectionCaption(caption) }}
  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  <p class="govuk-body">{{ copy.intro }}</p>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <input type="hidden" name="concurrencyToken" value="{{ concurrencyToken }}" />

    {{ govukInput({
      id: "nameOrOrganisationName", name: "nameOrOrganisationName",
      label: { text: copy.fields.nameOrOrganisationName },
      autocomplete: "name",
      value: values.nameOrOrganisationName,
      errorMessage: errors.nameOrOrganisationName and { text: errors.nameOrOrganisationName }
    }) }}

    {{ govukInput({
      id: "addressLine1", name: "addressLine1",
      label: { text: copy.fields.addressLine1 },
      autocomplete: "address-line1",
      value: values.addressLine1,
      errorMessage: errors.addressLine1 and { text: errors.addressLine1 }
    }) }}

    {{ govukInput({
      id: "addressLine2", name: "addressLine2",
      label: { text: copy.fields.addressLine2 },
      autocomplete: "address-line2",
      value: values.addressLine2,
      errorMessage: errors.addressLine2 and { text: errors.addressLine2 }
    }) }}

    {{ govukInput({
      id: "townOrCity", name: "townOrCity",
      label: { text: copy.fields.townOrCity },
      classes: "govuk-!-width-two-thirds",
      autocomplete: "address-level2",
      value: values.townOrCity,
      errorMessage: errors.townOrCity and { text: errors.townOrCity }
    }) }}

    {{ govukInput({
      id: "county", name: "county",
      label: { text: copy.fields.county },
      classes: "govuk-!-width-two-thirds",
      value: values.county,
      errorMessage: errors.county and { text: errors.county }
    }) }}

    {{ govukInput({
      id: "postcode", name: "postcode",
      label: { text: copy.fields.postcode },
      classes: "govuk-input--width-10",
      autocomplete: "postal-code",
      value: values.postcode,
      errorMessage: errors.postcode and { text: errors.postcode }
    }) }}

    {{ govukSelect({
      id: "country", name: "country",
      label: { text: copy.fields.country },
      items: countryItems,
      errorMessage: errors.country and { text: errors.country }
    }) }}

    {# Design release 1 closes the address at the country and heads the contact
       details separately, email first — as the commercial form already does. #}
    <h2 class="govuk-heading-m">{{ copy.contactHeading }}</h2>

    {{ govukInput({
      id: "email", name: "email",
      label: { text: copy.fields.email },
      type: "email",
      autocomplete: "email",
      value: values.email,
      errorMessage: errors.email and { text: errors.email }
    }) }}

    {{ govukInput({
      id: "phone", name: "phone",
      label: { text: copy.fields.phone },
      hint: { text: copy.telephoneHint },
      type: "tel",
      classes: "govuk-input--width-20",
      autocomplete: "tel",
      value: values.phone,
      errorMessage: errors.phone and { text: errors.phone }
    }) }}

    {# The private arm of the add route — reached from the type chooser, not
       from the hub, so it ends with the primary alone. #}
    {{ saveActions(hubHref, copy = sharedCopy.saveActions, showReturnControls = false) }}
  </form>
{% endblock %}
